# Copy to .env.local and fill in. The public site runs without these
# (it uses local seed data); Firebase is needed for the admin dashboard
# and live listings — see README-AQARAT.md.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Owner / super-admin email (the account that manages admins)
NEXT_PUBLIC_OWNER_EMAIL=owner@example.com

# Server-side Admin SDK (for persisting inquiries + secure writes). Keep the
# \n escapes in the private key and wrap it in quotes.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Emailing the office when an inquiry arrives. Zoho, the same account that
# holds info@homeskurdistan.com. Leave blank and inquiries are still saved —
# only the notification is skipped.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=info@homeskurdistan.com
SMTP_PASS=
# Where the alert goes. Defaults to SMTP_USER.
NOTIFY_EMAIL=

# Optional: the same alert on Telegram, which arrives faster than email.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
