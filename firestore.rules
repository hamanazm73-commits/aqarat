rules_version = '2';

// Deploy: Firebase console > Firestore > Rules > paste > Publish.
// Set ownerEmail() to the SAME email as NEXT_PUBLIC_OWNER_EMAIL (lowercase).

service cloud.firestore {
  match /databases/{database}/documents {

    function ownerEmail() {
      return "hamakali2005@gmail.com"; // owner / super-admin (lowercase)
    }
    function isSignedIn() { return request.auth != null; }
    function emailLower() { return request.auth.token.email.lower(); }
    function isOwner() { return isSignedIn() && emailLower() == ownerEmail(); }
    function hasRole() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/roles/$(emailLower()));
    }
    function myRole() {
      return get(/databases/$(database)/documents/roles/$(emailLower())).data;
    }
    function isAdmin() {
      return isOwner() ||
        (hasRole() && myRole().enabled == true
          && (myRole().role == 'admin' || myRole().role == 'owner'));
    }

    function isSeller() {
      return hasRole() && myRole().enabled == true && myRole().role == 'seller';
    }

    // Properties: anyone reads. Admins write anything; a seller writes only
    // listings carrying their own address, and only ever with their own
    // address on them — so one seller can neither reach into another's
    // listing nor hand their own away.
    //
    // featured and recommended are the two spots on the site that get looked
    // at first, and the office charges for them. The form no longer shows a
    // seller the boxes; this is what stops one being ticked anyway. A seller
    // may leave them as they are — they edit their own listing after the
    // office has promoted it — but may not turn one on.
    match /properties/{id} {
      allow read: if true;
      allow create: if isAdmin() ||
        (isSeller()
          && request.resource.data.sellerEmail == emailLower()
          && request.resource.data.get("featured", false) == false
          && request.resource.data.get("recommended", false) == false);
      allow update: if isAdmin() ||
        (isSeller()
          && resource.data.sellerEmail == emailLower()
          && request.resource.data.sellerEmail == emailLower()
          && request.resource.data.get("featured", false)
             == resource.data.get("featured", false)
          && request.resource.data.get("recommended", false)
             == resource.data.get("recommended", false));
      allow delete: if isAdmin() ||
        (isSeller() && resource.data.sellerEmail == emailLower());
    }

    // Access links: the document id IS the secret, so whoever holds it may
    // read the credentials behind it — that is what lets the link work with
    // nothing to type. `list` stays shut, and that is what keeps the id
    // secret: without it the collection cannot be enumerated to find one.
    match /accessLinks/{token} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Inquiries: anyone may CREATE a valid inquiry (contact form); only
    // owner/admins may read them. No client update/delete. Fields and sizes are
    // locked down so the public write can't be abused with junk or huge data.
    match /inquiries/{id} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(
          ['propertyId', 'name', 'phone', 'message', 'createdAt']) &&
        request.resource.data.propertyId is string &&
        request.resource.data.propertyId.size() > 0 &&
        request.resource.data.propertyId.size() <= 120 &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 6 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() <= 40 &&
        (!('message' in request.resource.data) ||
          (request.resource.data.message is string &&
           request.resource.data.message.size() <= 1000));
      allow update, delete: if false;
    }

    // Roles / admins: a user reads their own role; only the owner manages roles.
    match /roles/{email} {
      allow get: if isOwner() || (isSignedIn() && emailLower() == email);
      allow list: if isAdmin();
      // An admin may hand out and withdraw seller access, which is the point
      // of the sellers page. Only the owner may make another administrator —
      // otherwise anyone let in to manage listings could let themselves in
      // further.
      allow create, update: if isOwner() ||
        (isAdmin() && request.resource.data.role == 'seller');
      allow delete: if isOwner() ||
        (isAdmin() && resource.data.role == 'seller');
    }

    // Site settings (e.g. which cities appear in filters): public read, admin write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Submissions: anyone may submit a property; only admins read/manage it.
    match /submissions/{id} {
      allow read: if isAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['title', 'description',
          'purpose', 'type', 'city', 'district', 'priceIQD', 'area',
          'bedrooms', 'bathrooms', 'images', 'name', 'phone', 'whatsapp',
          'createdAt']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 2 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.purpose is string &&
        request.resource.data.type is string &&
        request.resource.data.city is string &&
        request.resource.data.priceIQD is number &&
        request.resource.data.area is number &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 2 &&
        request.resource.data.name.size() <= 80 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 6 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.images is list &&
        request.resource.data.images.size() <= 20 &&
        request.resource.data.createdAt is string;
      allow update, delete: if isAdmin();
    }
  }
}
